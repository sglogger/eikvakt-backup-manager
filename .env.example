# Local dev only. Copy to .env and override as needed.
# Ports are deconflicted against the other WordPress projects in ~/SourceCode
# (Vokull uses 90xx).

# Source site
WP_PORT=9190
# Second WordPress, the target for migration tests
WP_TARGET_PORT=9192
PMA_PORT=9191
MAILPIT_PORT=9125

# Storage test servers (FTP/FTPS and SFTP), reachable from WordPress by
# service name: ftp:21 and sftp:22.
FTP_PORT=2121
SFTP_PORT=2222
STORAGE_USER=backup
STORAGE_PASSWORD=backup-secret

DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=rootpass

# App key of the plugin's own Dropbox app ("Eikvakt Backup Manager" in the
# Dropbox App Console). Public, not a secret. Empty = only "own app" mode.
EKBM_DROPBOX_APP_KEY=
