# Local development environment for Eikvakt Backup Manager.
#
# Copy to docker-compose.yml (which is gitignored) and adjust ports if they
# clash with another project. `cp .env.example .env` first if you want to
# override credentials or ports without editing this file.
#
#   docker compose up -d
#   open http://localhost:9190          # WordPress (source site)
#   open http://localhost:9192          # WordPress (migration target)
#   open http://localhost:9191          # phpMyAdmin
#   open http://localhost:9125          # Mailpit — every report e-mail lands here
#
# Storage destinations to configure inside WordPress:
#   FTP   host "ftp",  port 21, user/password from .env, folder "backups"
#   SFTP  host "sftp", port 22, user/password from .env, folder "upload/backups"
#
# ./local_wp_core and ./local_wp_target start empty; the official image
# populates them with WordPress core on first boot. The repo root is mounted
# straight in as the plugin directory on both sites, so edits are live with no
# build step.

# wp-config.php of the official image reads these variables at runtime, so
# the web and the WP-CLI container of a site must see the same set.
x-wp-config-extra: &wp-config-extra |
  define('WP_DEBUG_LOG', true);
  define('WP_DEBUG_DISPLAY', false);
  define('SCRIPT_DEBUG', true);
  define('WP_ENVIRONMENT_TYPE', 'local');
  // App key of the plugin's own Dropbox app (see docs/storage-drivers.md).
  if ( getenv('EKBM_DROPBOX_APP_KEY') ) { define('EKBM_DROPBOX_APP_KEY', getenv('EKBM_DROPBOX_APP_KEY')); }
  // Uncomment if you locked yourself out with the plugin password:
  // define('EKBM_DISABLE_PASSWORD', true);

x-source-env: &source-env
  WORDPRESS_DB_HOST: db:3306
  WORDPRESS_DB_NAME: wordpress
  WORDPRESS_DB_USER: wordpress
  WORDPRESS_DB_PASSWORD: ${DB_PASSWORD:-wordpress}
  WORDPRESS_DEBUG: "1"
  WORDPRESS_CONFIG_EXTRA: *wp-config-extra
  WP_PORT: ${WP_PORT:-9190}
  WP_TARGET_PORT: ${WP_TARGET_PORT:-9192}
  EKBM_DROPBOX_APP_KEY: ${EKBM_DROPBOX_APP_KEY:-}

# A second, independent site to test migrations against. Different table
# prefix on purpose, so prefix rewriting is exercised too.
x-target-env: &target-env
  WORDPRESS_DB_HOST: db:3306
  WORDPRESS_DB_NAME: wordpress_target
  WORDPRESS_DB_USER: wordpress
  WORDPRESS_DB_PASSWORD: ${DB_PASSWORD:-wordpress}
  WORDPRESS_TABLE_PREFIX: wpt_
  WORDPRESS_DEBUG: "1"
  WORDPRESS_CONFIG_EXTRA: *wp-config-extra
  WP_PORT: ${WP_PORT:-9190}
  WP_TARGET_PORT: ${WP_TARGET_PORT:-9192}
  EKBM_DROPBOX_APP_KEY: ${EKBM_DROPBOX_APP_KEY:-}

services:
  db:
    image: mariadb:11
    restart: unless-stopped
    environment:
      MARIADB_DATABASE: wordpress
      MARIADB_USER: wordpress
      MARIADB_PASSWORD: ${DB_PASSWORD:-wordpress}
      MARIADB_ROOT_PASSWORD: ${DB_ROOT_PASSWORD:-rootpass}
    volumes:
      - ./db_data:/var/lib/mysql
      - ./dev/mariadb-init:/docker-entrypoint-initdb.d:ro
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      retries: 5

  wordpress:
    build:
      context: ./dev/docker
      dockerfile: wordpress.Dockerfile
    image: eikvakt-dev/wordpress:php8.2
    depends_on:
      db:
        condition: service_healthy
    restart: unless-stopped
    ports:
      - "${WP_PORT:-9190}:80"
    environment: *source-env
    volumes:
      - ./local_wp_core:/var/www/html
      - .:/var/www/html/wp-content/plugins/eikvakt-backup-manager
      - ./dev/mu-plugins:/var/www/html/wp-content/mu-plugins

  wordpress-target:
    image: eikvakt-dev/wordpress:php8.2
    depends_on:
      db:
        condition: service_healthy
    restart: unless-stopped
    ports:
      - "${WP_TARGET_PORT:-9192}:80"
    environment: *target-env
    volumes:
      - ./local_wp_target:/var/www/html
      - .:/var/www/html/wp-content/plugins/eikvakt-backup-manager
      - ./dev/mu-plugins:/var/www/html/wp-content/mu-plugins

  # The official `wordpress` image does NOT bundle WP-CLI — only the separate
  # `wordpress:cli` image does. Running as uid 33 (www-data) keeps file
  # ownership consistent with the web container and avoids --allow-root.
  wpcli:
    build:
      context: ./dev/docker
      dockerfile: wpcli.Dockerfile
    image: eikvakt-dev/wpcli:php8.2
    depends_on:
      db:
        condition: service_healthy
    user: "33:33"
    entrypoint: /bin/sh
    command: -c "tail -f /dev/null"
    environment: *source-env
    volumes:
      - ./local_wp_core:/var/www/html
      - .:/var/www/html/wp-content/plugins/eikvakt-backup-manager
      - ./dev/mu-plugins:/var/www/html/wp-content/mu-plugins

  wpcli-target:
    image: eikvakt-dev/wpcli:php8.2
    depends_on:
      db:
        condition: service_healthy
    user: "33:33"
    entrypoint: /bin/sh
    command: -c "tail -f /dev/null"
    environment: *target-env
    volumes:
      - ./local_wp_target:/var/www/html
      - .:/var/www/html/wp-content/plugins/eikvakt-backup-manager
      - ./dev/mu-plugins:/var/www/html/wp-content/mu-plugins

  # FTP / FTPS test server. FTPS uses a self-signed certificate; create it
  # once with:
  #   docker run --rm -v "$PWD/dev/ftp-tls":/out alpine/openssl req -x509 -newkey rsa:2048 -nodes \
  #     -days 3650 -subj "/CN=ftp" -keyout /out/ftp.key -out /out/ftp.crt
  # and use "Test" in the plugin to see the key to pin.
  ftp:
    image: delfer/alpine-ftp-server:latest
    restart: unless-stopped
    environment:
      USERS: "${STORAGE_USER:-backup}|${STORAGE_PASSWORD:-backup-secret}|/home/backup"
      ADDRESS: ftp
      MIN_PORT: 21000
      MAX_PORT: 21010
      TLS_CERT: /tls/ftp.crt
      TLS_KEY: /tls/ftp.key
    volumes:
      - ./dev/ftp-tls:/tls:ro
    ports:
      - "${FTP_PORT:-2121}:21"

  # SFTP test server. The user's writable folder is "upload".
  sftp:
    image: atmoz/sftp:alpine
    restart: unless-stopped
    command: "${STORAGE_USER:-backup}:${STORAGE_PASSWORD:-backup-secret}:::upload"
    ports:
      - "${SFTP_PORT:-2222}:22"

  # Catches every wp_mail() so report delivery can actually be verified.
  mailpit:
    image: axllent/mailpit:latest
    restart: unless-stopped
    ports:
      - "${MAILPIT_PORT:-9125}:8025"

  phpmyadmin:
    image: phpmyadmin:latest
    depends_on:
      db:
        condition: service_healthy
    restart: unless-stopped
    ports:
      - "${PMA_PORT:-9191}:80"
    environment:
      PMA_HOST: db
      PMA_PORT: 3306
      PMA_USER: root
      PMA_PASSWORD: ${DB_ROOT_PASSWORD:-rootpass}
      UPLOAD_LIMIT: 256M
